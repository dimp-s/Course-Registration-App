@model CourseRegistrationApp.Models.ViewModels.StudenDashboardViewModel

<h2>Welcome, @Model.FirstName</h2>

<div>
    <img src="~/@Model.ProfileImage" class="rounded-circle border" width="150" alt="Profile Photo" />
</div>

<form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" class="mt-2">
    <input type="file" name="ProfileImage" accept="image/*" />
    <button type="submit" class="btn btn-sm btn-primary">Upload Photo</button>
</form>

<h3>Your Enrolled Courses</h3>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>CreditHours</th>
            <th>Enrolled On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model.EnrolledCourses) {
            <tr>
                <td>@course.Name</td>
                <td>@course.CreditHours</td>
                <td>@course.EnrolledOn</td>
            </tr>
        }
    </tbody>
</table>

